# ---------------------------------------------------
# AstraGod — Environment Configuration
# Copy this file to ".env" and fill in your own values.
# NEVER commit your real ".env" file to version control.
# ---------------------------------------------------

# The API key for your chosen AI provider (OpenAI, Anthropic, etc.)
AI_API_KEY=your_api_key_here

# The base completion/chat endpoint of your chosen AI provider
# Examples:
#   OpenAI:    https://api.openai.com/v1/chat/completions
#   Anthropic: https://api.anthropic.com/v1/messages
AI_API_URL=https://api.openai.com/v1/chat/completions

# The model identifier to request from the provider
AI_MODEL=gpt-4o-mini

# Port the Express server listens on
PORT=3000

# Comma-separated list of allowed CORS origins (use * only in local dev)
ALLOWED_ORIGINS=http://localhost:3000

# Max requests per IP per minute (basic rate limiting)
RATE_LIMIT_MAX=30
